// Project LOOP — Multi-Tenant AI Customer-Feedback Intelligence Platform Schema

generator client {
  provider = "prisma-client-js"
  output   = "../../frontend/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Tenant-owned relations
  users    User[]
  feedback Feedback[]
  themes   Theme[]
  reports  Report[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  workspaceId  String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([workspaceId])
}

model Feedback {
  id             String         @id @default(uuid())
  content        String         @db.Text
  channel        String         // e.g. "support_ticket", "app_review", "nps_survey", "sales_call", "social"
  sourceRef      String?        // reference/id from source system
  customerLabel  String?        // customer name/company
  sentiment      Sentiment?
  sentimentScore Float?         // Range: -1.0 to 1.0
  status         FeedbackStatus @default(NEW)
  createdAt      DateTime       @default(now())
  workspaceId    String

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes    FeedbackTheme[]
  embedding Embedding?

  @@index([workspaceId])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model Theme {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  // Hex color code e.g. "#6366F1"
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback  FeedbackTheme[]

  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float  // AI confidence score (range 0.0 to 1.0)

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([feedbackId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(uuid())
  feedbackId String   @unique
  
  // PostgreSQL pgvector extension type (1536 dimensions for OpenAI embeddings)
  vector     Unsupported("vector(1536)")
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id            String   @id @default(uuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   Json
  createdAt     DateTime @default(now())
  workspaceId   String
  generatedById String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy User      @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([generatedById])
}
